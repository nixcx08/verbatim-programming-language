# Bubble sort
func sort(a: [int]) -> [int] {
    let i: int = 0
    while i < len(a) {
        let j: int = 0
        while j < len(a) - 1 - i {
            if a[j] > a[j + 1] {
                let tmp: int = a[j]
                a[j] = a[j + 1]
                a[j + 1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
    return a
}

let nums: [int] = [5, 2, 9, 1, 7]
let sorted: [int] = sort(nums)
let k: int = 0
while k < len(sorted) {
    print(str(sorted[k]))
    k = k + 1
}
print("original first: " + str(nums[0]))
